FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
FEISHU_BASE_NAME=抖音内容采集库
FEISHU_TABLE_NAME=采集库
# 同时处理的飞书记录数；建议 2，过高容易触发飞书或语音接口限流
FEISHU_RECORD_CONCURRENCY=2
WEB_HOST=127.0.0.1
WEB_PORT=3210

# none=不保存视频；feishu=保留原视频；feishu_compressed=保存 720p 压缩视频
VIDEO_STORAGE_MODE=none
# 压缩归档参数；数值越大的 CRF 文件越小、画质越低
VIDEO_ARCHIVE_MAX_WIDTH=720
VIDEO_ARCHIVE_CRF=28
# 项目自带 FFmpeg；仅在需要使用外部版本时填写
FFMPEG_PATH=

# 任务租约与失败退避；通常保持默认即可
PIPELINE_LEASE_SECONDS=900
PIPELINE_MAX_ATTEMPTS=5
PIPELINE_RETRY_BASE_SECONDS=60
PIPELINE_RETRY_MAX_SECONDS=3600

# 统一 HTTP 策略：普通接口、AI 接口和大媒体传输分别设置超时
HTTP_TIMEOUT_MS=30000
HTTP_MAX_RETRIES=2
HTTP_RETRY_BASE_MS=500
HTTP_RETRY_MAX_MS=30000
AI_HTTP_TIMEOUT_MS=180000
MEDIA_HTTP_TIMEOUT_MS=600000

# AI 提供方：auto 会优先使用 OpenRouter，其次使用百炼
AI_PROVIDER=auto
# primary=只用首选，fallback=失败后降级，compare=调用全部服务作旁证
ASR_MODE=fallback

# OpenRouter：同时用于语音转写、逐字稿校对和内容分析
OPENROUTER_API_KEY=
OPENROUTER_ASR_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_ASR_FALLBACK_MODEL=openai/whisper-large-v3
OPENROUTER_ASR_QUALITY_GATE=true
OPENROUTER_ANALYSIS_MODEL=qwen/qwen3.7-flash
# 逗号分隔；显式设置后替代内置备用链。旧的单值 FALLBACK_MODEL 仍兼容。
OPENROUTER_ANALYSIS_FALLBACK_MODELS=openai/gpt-oss-20b,deepseek/deepseek-v4-flash
OPENROUTER_REVIEW_MODEL=qwen/qwen3.7-flash
OPENROUTER_VERIFY_MODEL=openai/gpt-oss-20b

# 阿里云百炼（可选备用）
DASHSCOPE_API_KEY=
BAILIAN_ASR_MODEL=paraformer-v2
BAILIAN_REVIEW_MODEL=qwen3.7-flash-2026-07-15
BAILIAN_VERIFY_MODEL=qwen3.7-plus
BAILIAN_ANALYSIS_MODEL=qwen3.7-flash-2026-07-15
ENABLE_TEXT_PROOFREAD=false
# 创建专业热词表后可填写
BAILIAN_VOCABULARY_ID=

# 火山引擎豆包语音（新版控制台，推荐）
VOLCENGINE_SPEECH_API_KEY=
# 旧版控制台使用下面两项；新版留空
VOLCENGINE_SPEECH_APP_KEY=
VOLCENGINE_SPEECH_ACCESS_KEY=
VOLCENGINE_SPEECH_RESOURCE_ID=volc.bigasr.auc_turbo
